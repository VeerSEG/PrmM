{
  "Name": "MERGE",
  "Type": "Workflow",
  "Description": "This workflow will be triggered when a merge request is created or reopened. It will read the validation list, perform project CI processes, and generate a report template.",
  "RequiredNode": "Git",
  "CanExecuteLocal": false,
  "WorkflowRepo": {
    "Type": "ReposSet",
    "Repos": {
      "PTCKpiM": {
        "Type": "SEGGitlab",
        "Branch": "Developer",
        "UrlRelativePath": "ci-development/ptc-kpi-m.git"
      }
    }
  },
  "WorkflowRunnerRepo": {
    "Type": "SEGGitlab",
    "Branch": "main",
    "UrlRelativePath": "ci-development/workflowrunner.git"
  },
  "When": {
    "Condition": "$gitlabMergeRequestState -eq 'opened' -or $gitlabMergeRequestState -eq 'reopened'"
  },
  "WithEnv": [
    {
      "Key": "_MonitorBranches",
      "Value": "$SandboxPath/.seg/CI/CaC/MonitorBranches.json"
    },
    {
      "Key": "_GlobalJenkinsConfig",
      "Value": "$SEGJenkinsShareFolder\\Configs\\GlobalConfigs\\Configs.json"
    },
    {
      "Key": "_ProjectJenkinsConfig",
      "Value": "$SEGJenkinsShareFolder\\Configs\\ProjectConfigs\\$ProjectName\\Configs.json"
    }
  ],
  "Stages": [
    {
      "Name": "Information Read and Process",
      "Type": "ParallelStages",
      "Parallel": [
        {
          "Name": "ValidationListRead",
          "Type": "ParallelSet",
          "Stages": [
            {
              "Name": "Read Validation List",
              "Type": "Stage",
              "Desc": "Read the validations need to be performed.",
              "ModuleName": "$WorkflowRunnerLoc/Modules/WorkflowRunner-MergeRequest",
              "FunctionName": "Get-MarkdownCheckboxStatus",
              "NamedParams": {
                "ChapterTitle": "## Performing Validation",
                "Content": "$gitlabMergeRequestDescription"
              },
              "GitlabIntegration": true,
              "OutputProcess": {
                "OutputFilePath": "$ArchivePath/ValidationList.json"
              }
            }
          ]
        },
        {
          "Name": "Meta Projects Setting Up",
          "Type": "ParallelSet",
          "Stages": [
            {
              "Name": "Setup Meta Repos with Integration.yml",
              "Type": "Stage",
              "Description": "Update repos to use the Meta Repos",
              "ModuleName": "$SandboxPath/.seg/Scripts/Meta/Modules/Meta-Action",
              "FunctionName": "Update-RepoToTargetConfigure",
              "NamedParams": {
                "IntegrationFile": "seg_meta/integration.yml",
                "SandboxPath": "$SandboxPath",
                "MetaCache": "$GlobalContainer/Meta/RepoPackages",
                "IgnoreGit":true,
                "Token": {
                  "gitlab.web.sg.lan": "$env:SEGGitlabTokenSecretText",
                  "git4ea.web.sg.lan": "$env:SEGEAGitlabTokenSecretText"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "Name": "Project CI Process",
      "Type": "ParallelStages",
      "Parallel": [
        {
          "Name": "ProjectValidation",
          "Type": "ParallelSet",
          "Stages": [
            {
              "Name": "CreateSoftware",
              "Type": "Workflow",
              "GitlabIntegration": true,
              "IgnoreError": true,
              "NamedParams": {
                "JobName": "\"CreateSoftware\"",
                "JobFolder": "\"$ProjectJenkinsRootFolder/$(if($_MonitorBranches|Where-Object{$SandboxProjectDevPath -like $_ }){$SandboxProjectDevPath}else{\"ElseBranches\"})/BuildSW\"",
                "CanShareSandbox": true,
                "ObtainTestsResult": true
              },
              "SignatureStage": {
                "SignatureVector": [
                  {
                    "Type": "\"Directory\"",
                    "Path": "$SandboxPath",
                    "FileMatches": [
                      "\"(cfg|src)/((?!ci/).)*\\.(c|h|a2l|ini)$\"",
                      "\"^workflows/BuildSW\""
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "Name": "TaskValidation",
          "Type": "ParallelSet",
          "Stages": [
            {
              "Name": "Read Task Info",
              "Type": "Stage",
              "Desc": "Task Id should belongs to the current project. And the status shoulde be In progress.",
              "ModuleName": "$WorkflowRepoPath/PTCKpiM/Modules/PTCKpiM-TaskValidation",
              "FunctionName": "Confirm-TaskStatus",
              "NamedParams": {
                "ExpectedProject": "$($ProjectInfos.WindChillProjectInformation.ProjectPath)",
                "ExpectedState": "In progress",
                "ExpectedUser": "$($BuildTriggerUser.NTAccount)",
                "TaskID": "$($gitlabMergeRequestTitle.Split('-')[-1])"
              },
              "WithEnv": [
                {
                  "Key": "ProjectInfos",
                  "Value": "$SandboxPath/.seg/CI/CIEnvConfig/ProjectInfos/ProjectInfos.json"
                }
              ],
              "GitlabIntegration": true,
              "IgnoreError": true
            }
          ]
        }
      ],
      "WithEnv": [
        {
          "Key": "_ValidationList",
          "Value": "$ArchivePath/ValidationList.json"
        }
      ]
    },
    {
      "Name": "Generate Report Template",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Activities",
      "FunctionName": "Out-ReportWithTestCasesFilter",
      "NamedParams": {
        "Changes": "$SandboxContext.Changes",
        "OutputPath": "$WorkspacePath/ReportsTemplate/Report.json"
      }
    },
    {
      "Name": "Add Matrix To Notification",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Basic",
      "FunctionName": "Add-Matrix",
      "NamedParams": {
        "InputFileLocation": "$WorkspacePath/ReportsTemplate/Report.json",
        "Matrix": [
          {
            "Name": "\"Merge Reqeust Info\"",
            "Contents": [
              {
                "Name": "\"Title\"",
                "Value": "$gitlabMergeRequestTitle"
              },
              {
                "Name": "\"Description\"",
                "Value": "$gitlabMergeRequestDescription"
              }
            ]
          }
        ],
        "OutputLocation": "$WorkspacePath/ReportsTemplate/Report.json"
      }
    },
    {
      "Name": "Add Links To Notification",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Basic",
      "FunctionName": "Add-Links",
      "NamedParams": {
        "InputFileLocation": "$WorkspacePath/ReportsTemplate/Report.json",
        "Links": [
          {
            "Name": "\"MergeRequestTicket\"",
            "Link": "\"$gitlabSourceRepoHomepage/-/merge_requests/$gitlabMergeRequestIid\""
          }
        ],
        "OutputLocation": "$WorkspacePath/ReportsTemplate/Report.json"
      }
    },
    {
      "Name": "Add Report To TriggerUser",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Basic",
      "FunctionName": "Add-PostInChat",
      "NamedParams": {
        "InputFileLocation": "$WorkspacePath/ReportsTemplate/Report.json",
        "OutputLocation": "$ReportPath/ReportOnChat.json",
        "Users": [
          "$BuildTriggerUser.Email",
          "$SandboxContext.Changes.AuthorEmail",
          "if($_ProjectJenkinsConfig){$_ProjectJenkinsConfig.StakeHolders.Users|Where-Object{($JOB_NAME+'::'+$env:CurrentBuildStatus)|Select-String -Pattern $_.StakeHoldersTags}|Select-Object -ExpandProperty GroupName}",
          "if($_GlobalJenkinsConfig){$_GlobalJenkinsConfig.StakeHolders.Users|Where-Object{($JOB_NAME+'::'+$env:CurrentBuildStatus)|Select-String -Pattern $_.StakeHoldersTags}|Select-Object -ExpandProperty GroupName}"
        ]
      }
    },
    {
      "Name": "Add Report To Group",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Basic",
      "FunctionName": "Add-PostInGroup",
      "NamedParams": {
        "Groups": [
          "if($_ProjectJenkinsConfig){$_ProjectJenkinsConfig.StakeHolders.Groups|Where-Object{($JOB_NAME+'::'+$env:CurrentBuildStatus)|Select-String -Pattern $_.StakeHoldersTags}|Select-Object -ExpandProperty GroupName}",
          "if($_GlobalJenkinsConfig){$_GlobalJenkinsConfig.StakeHolders.Groups|Where-Object{($JOB_NAME+'::'+$env:CurrentBuildStatus)|Select-String -Pattern $_.StakeHoldersTags}|Select-Object -ExpandProperty GroupName}"
        ],
        "InputFileLocation": "$ReportPath/ReportOnChat.json",
        "OutputLocation": "$ReportPath/ReportOnGroup.json"
      },
      "When": {
        "Condition": "($_MonitorBranches|Where-Object{$SandboxProjectDevPath -like $_ })"
      }
    },
    {
      "Name": "Send Reports",
      "Type": "Stage",
      "ModuleName": "$WorkflowRunnerLoc/Dependencies/adaptive-card/Modules/AdaptiveCard-Activities",
      "FunctionName": "Resolve-WithTemplateAndOutputReportToTeams",
      "NamedParams": {
        "ContextFolder": "$ReportPath",
        "OutputFolder": "$TempFolderPath/Reports/Resolved"
      },
      "RetryTimes": 200
    }
  ],
  "Lock": "$ProjectPath::MergeRequest::$gitlabMergeRequestIid",
  "WithCredentials": {
    "SecretText": [
      "SEGEAGitlabTokenSecretText",
      "SEGGitlabTokenSecretText"
    ],
    "UserInfo": [
      "JenkinsUser"
    ]
  }
}