{
  "title": "Component Implementation Review",
  "type": "object",
  "properties": {
    "Overview": {
      "type": "object",
      "title": "Review Information Overview",
      "properties": {
        "ProjectInformation": {
          "type": "string",
          "enum": [
            "P200 - 5000751\r",
            "P210 - 5001588\r",
            "P211 - 9000408\r",
            "P212 - 5001310\r",
            "P215 - 5001596\r",
            "P220 - 5001027\r",
            "P222 - 5001027\r",
            "P230 - 5001420\r",
            "P231 - 5001571\r",
            "P232 - 5001628\r",
            "P240 - 5001045\r",
            "P250 - 5001019,5001258\r",
            "P260 - 5001696\r",
            "P263 - 5001653\r",
            "P264 - 8000546\r",
            "P265 - 5001714\r",
            "P270 - 5001436\r",
            "P280 - 5001097\r",
            "H100 - 5001681\r",
            "H110 - 5001681"
          ],
          "title": "Project Name"
        },
        "ReviewMethod": {
          "type": "string",
          "title": "Method",
          "oneOf": [
            {
              "const": "PassAround",
              "title": "Pass Around"
            },
            {
              "const": "WalkThurough",
              "title": "Walk-Thurough"
            },
            {
              "const": "Inspection",
              "title": "Inspection (for safety-Relevant WP)"
            }
          ]
        },
        "ReviewWorkProduct": {
          "type": "string",
          "title": "Review Work Product",
          "oneOf": [
            {
              "const": "SWImplementation-HandCoded",
              "title": "Software Implementation (Hand Coded)"
            },
            {
              "const": "SWImplementation-ModelBased",
              "title": "Software Implementation (Model Based)"
            },
            {
              "const": "SWImplementation-Configured",
              "title": "Software Implementation (Configured)"
            }
          ]
        },
        "ReviewScope": {
          "type": "string",
          "title": "Review Scope",
          "oneOf": [
            {
              "const": "FullReview",
              "title": "Full Review"
            },
            {
              "const": "DeltaReview",
              "title": "Delta Review"
            }
          ]
        },
        "ReviewItems": {
          "type": "array",
          "title": "Work Products",
          "items": {
            "type": "object",
            "required": [
              "DocumentID",
              "Author",
              "Version"
            ],
            "title": "Work Product Information",
            "properties": {
              "DocumentID": {
                "type": "string",
                "description": "Defined Content (Feature, Component etc.)*, Release Name (if available)",
                "title": "Document ID"
              },
              "Version": {
                "type": "string",
                "description": "Version, baseline, or date-time identifying this work product",
                "title": "Work Product Version / Baseline / Date + Time"
              },
              "Author": {
                "type": "string",
                "description": "Name of the responsible author or owner",
                "title": "Author"
              }
            }
          }
        },
        "ReviewTeam": {
          "type": "object",
          "title": "Review Team Members",
          "properties": {
            "MandatoryMembers": {
              "type": "object",
              "required": [
                "Author",
                "PeerSWDeveloper",
                "SWArchitect"
              ],
              "title": "Mandatory Members for Review Team",
              "properties": {
                "Author": {
                  "type": "object",
                  "required": [
                    "ReviewTeamRole",
                    "Name",
                    "ProjectRole",
                    "ReviewScope"
                  ],
                  "title": "Review Team Member",
                  "properties": {
                    "Name": {
                      "type": "string",
                      "description": "Full name of the team member",
                      "title": "Name"
                    },
                    "ProjectRole": {
                      "const": "PeerSWDeveloper",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "PeerSWDeveloper",
                          "title": "Peer SW Developer"
                        },
                        {
                          "const": "SWArchitect",
                          "title": "SW Architect"
                        },
                        {
                          "const": "SWDeveloper",
                          "title": "SW Developer"
                        }
                      ],
                      "default": "PeerSWDeveloper",
                      "readOnly": true,
                      "title": "Project Role"
                    },
                    "ReviewScope": {
                      "description": "Select all applicable review focus areas",
                      "type": "array",
                      "items": {
                        "enum": [
                          "Completeness",
                          "Correctness",
                          "Trace",
                          "Clarity",
                          "Design Principles",
                          "Testability",
                          "Robustness"
                        ],
                        "type": "string"
                      },
                      "default": [
                        "Completeness",
                        "Correctness",
                        "Robustness",
                        "Clarity",
                        "Testability"
                      ],
                      "uniqueItems": true,
                      "title": "Review Scope"
                    },
                    "ReviewTeamRole": {
                      "const": "Reviewer",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "Author",
                          "title": "Author"
                        },
                        {
                          "const": "Moderator",
                          "title": "Moderator"
                        },
                        {
                          "const": "Reviewer",
                          "title": "Reviewer"
                        }
                      ],
                      "default": "Reviewer",
                      "readOnly": true,
                      "title": "Review Team Role"
                    }
                  }
                },
                "PeerSWDeveloper": {
                  "type": "object",
                  "required": [
                    "ReviewTeamRole",
                    "Name",
                    "ProjectRole",
                    "ReviewScope"
                  ],
                  "title": "Review Team Member",
                  "properties": {
                    "Name": {
                      "type": "string",
                      "description": "Full name of the team member",
                      "title": "Name"
                    },
                    "ProjectRole": {
                      "const": "PeerSWDeveloper",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "PeerSWDeveloper",
                          "title": "Peer SW Developer"
                        },
                        {
                          "const": "SWArchitect",
                          "title": "SW Architect"
                        },
                        {
                          "const": "SWDeveloper",
                          "title": "SW Developer"
                        }
                      ],
                      "default": "PeerSWDeveloper",
                      "readOnly": true,
                      "title": "Project Role"
                    },
                    "ReviewScope": {
                      "description": "Select all applicable review focus areas",
                      "type": "array",
                      "items": {
                        "enum": [
                          "Completeness",
                          "Correctness",
                          "Trace",
                          "Clarity",
                          "Design Principles",
                          "Testability",
                          "Robustness"
                        ],
                        "type": "string"
                      },
                      "default": [
                        "Completeness",
                        "Correctness",
                        "Robustness",
                        "Clarity",
                        "Testability"
                      ],
                      "uniqueItems": true,
                      "title": "Review Scope"
                    },
                    "ReviewTeamRole": {
                      "const": "Reviewer",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "Author",
                          "title": "Author"
                        },
                        {
                          "const": "Moderator",
                          "title": "Moderator"
                        },
                        {
                          "const": "Reviewer",
                          "title": "Reviewer"
                        }
                      ],
                      "default": "Reviewer",
                      "readOnly": true,
                      "title": "Review Team Role"
                    }
                  }
                },
                "SWArchitect": {
                  "type": "object",
                  "required": [
                    "ReviewTeamRole",
                    "Name",
                    "ProjectRole",
                    "ReviewScope"
                  ],
                  "title": "Review Team Member",
                  "properties": {
                    "Name": {
                      "type": "string",
                      "description": "Full name of the team member",
                      "title": "Name"
                    },
                    "ProjectRole": {
                      "const": "SWArchitect",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "PeerSWDeveloper",
                          "title": "Peer SW Developer"
                        },
                        {
                          "const": "SWArchitect",
                          "title": "SW Architect"
                        },
                        {
                          "const": "SWDeveloper",
                          "title": "SW Developer"
                        }
                      ],
                      "default": "SWArchitect",
                      "readOnly": true,
                      "title": "Project Role"
                    },
                    "ReviewScope": {
                      "description": "Select all applicable review focus areas",
                      "type": "array",
                      "items": {
                        "enum": [
                          "Completeness",
                          "Correctness",
                          "Trace",
                          "Clarity",
                          "Design Principles",
                          "Testability",
                          "Robustness"
                        ],
                        "type": "string"
                      },
                      "default": [
                        "Completeness",
                        "Clarity"
                      ],
                      "uniqueItems": true,
                      "title": "Review Scope"
                    },
                    "ReviewTeamRole": {
                      "const": "Reviewer",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "Author",
                          "title": "Author"
                        },
                        {
                          "const": "Moderator",
                          "title": "Moderator"
                        },
                        {
                          "const": "Reviewer",
                          "title": "Reviewer"
                        }
                      ],
                      "default": "Reviewer",
                      "readOnly": true,
                      "title": "Review Team Role"
                    }
                  }
                }
              }
            },
            "AdditionalMembers": {
              "type": "array",
              "title": "Additional Members for Review Team",
              "items": {
                "type": "object",
                "required": [
                  "ReviewTeamRole",
                  "Name",
                  "ProjectRole",
                  "ReviewScope"
                ],
                "title": "Review Team Member",
                "properties": {
                  "Name": {
                    "type": "string",
                    "description": "Full name of the team member",
                    "title": "Name"
                  },
                  "ProjectRole": {
                    "type": "string",
                    "title": "Project Role",
                    "oneOf": [
                      {
                        "const": "PeerSWDeveloper",
                        "title": "Peer SW Developer"
                      },
                      {
                        "const": "SWArchitect",
                        "title": "SW Architect"
                      },
                      {
                        "const": "SWDeveloper",
                        "title": "SW Developer"
                      }
                    ]
                  },
                  "ReviewScope": {
                    "type": "array",
                    "uniqueItems": true,
                    "description": "Select all applicable review focus areas",
                    "title": "Review Scope",
                    "items": {
                      "enum": [
                        "Completeness",
                        "Correctness",
                        "Trace",
                        "Clarity",
                        "Design Principles",
                        "Testability",
                        "Robustness"
                      ],
                      "type": "string"
                    }
                  },
                  "ReviewTeamRole": {
                    "type": "string",
                    "title": "Review Team Role",
                    "oneOf": [
                      {
                        "const": "Author",
                        "title": "Author"
                      },
                      {
                        "const": "Moderator",
                        "title": "Moderator"
                      },
                      {
                        "const": "Reviewer",
                        "title": "Reviewer"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "MandatoryMembers"
          ]
        }
      },
      "required": [
        "ProjectInformation",
        "ReviewMethod",
        "ReviewWorkProduct",
        "ReviewScope",
        "ReviewItems",
        "ReviewTeam"
      ]
    },
    "Findings": {
      "type": "array",
      "title": "ReviewLog",
      "items": {
        "type": "object",
        "required": [
          "Information",
          "Evaluation",
          "Confirmation"
        ],
        "title": "Finding",
        "properties": {
          "Information": {
            "title": "Finding Information",
            "type": "object",
            "properties": {
              "WPReference": {
                "type": "string",
                "description": "Full name of the team member",
                "title": "Work Product Reference"
              },
              "Location": {
                "type": "string",
                "description": "e.g. Page/Line , Model Path etc.",
                "title": "Location"
              },
              "Category": {
                "type": "string",
                "enum": [
                  "Formality",
                  "Attributes",
                  "Trace",
                  "Clarity",
                  "Completeness",
                  "Correctness",
                  "Robustness",
                  "Design",
                  "Verifiability",
                  "Miscellaneous",
                  "Test Case Specification",
                  "Test Case Report",
                  "Test Automation"
                ],
                "title": "Finding Category"
              },
              "Description": {
                "type": "string",
                "title": "Finding Description"
              },
              "Reviewer": {
                "type": "string",
                "description": "name & department",
                "title": "Reviewer"
              }
            },
            "required": [
              "WPReference",
              "Location",
              "Category",
              "Description",
              "Reviewer"
            ]
          },
          "Evaluation": {
            "title": "Evaluation and corrective actions",
            "type": "object",
            "properties": {
              "Evaluation": {
                "type": "string",
                "enum": [
                  "Accepted",
                  "NotAccepted"
                ],
                "title": "Finding Evaluation"
              },
              "Action": {
                "title": "Corrective Action",
                "type": "string"
              },
              "ActionStatus": {
                "title": "Corrective Status",
                "type": "boolean"
              },
              "Comment": {
                "type": "string"
              },
              "Plan": {
                "title": "(To be) Fixed in baseline(optional)",
                "type": "string"
              }
            },
            "required": [
              "Evaluation",
              "Action",
              "ActionStatus",
              "Comment"
            ]
          },
          "Confirmation": {
            "title": "Confirmation of Closure",
            "type": "boolean"
          }
        }
      }
    },
    "CheckList": {
      "type": "object",
      "required": [
        "Prerequisites",
        "Completeness_1",
        "Trace",
        "Clarity",
        "Completeness_2",
        "Robustness"
      ],
      "title": "SW Component Implementation Checklist",
      "properties": {
        "Prerequisites": {
          "type": "object",
          "title": "Pre-requisites",
          "properties": {
            "SWIM1": {
              "type": "object",
              "title": "SWIM1-Is the Software Implementation Guideline & review process checked & followed by the developer for SW unit construction (source code) & technical review?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM3": {
              "type": "object",
              "title": "SWIM3-Baseline planning: Is the artifact to be reviewed checked in or delivered in the stream?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM2": {
              "type": "object",
              "title": "SWIM2-Inputs: Are all documents needed for the review available in their required state? (e.g., source code, SW detailed design, static test reports such as MISRA checks, Polyspace, compiler warnings, model advisor for MBD, ...)",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM1",
            "SWIM2",
            "SWIM3"
          ]
        },
        "Completeness_1": {
          "type": "object",
          "title": "Completeness",
          "properties": {
            "SWIM4": {
              "type": "object",
              "title": "SWIM4-Completeness: Is it checked that the Code is complete, covers the Design, and complements all parts of the design? Is there no part of the implementation that is not covered in the SW Design?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM6": {
              "type": "object",
              "title": "SWIM6-Definitions: Is it checked that all definition of Code and Data area are included in the defined Program/Memory Assignment and not duplicated or shadowed?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM4",
            "SWIM6"
          ]
        },
        "Trace": {
          "type": "object",
          "title": "Trace",
          "properties": {
            "SWIM7": {
              "type": "object",
              "title": "SWIM7-Traceability: Is correct bidirectional traceability established per the Detail design & implementation guideline to design elements and all implemented requirements? (e.g., naming conventions between Model / Source Code, code comments, SW Detailed Design).",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM7"
          ]
        },
        "Clarity": {
          "type": "object",
          "title": "Clarity",
          "properties": {
            "SWIM15": {
              "type": "object",
              "title": "SWIM15-Division: For all divisions, has the denominator been tested to be non-zero? (If zero can be excluded, justify in comment.)",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM10": {
              "type": "object",
              "title": "SWIM10-Identifiers: Naming convention fulfilled (signals/variables)? No identifiers rely on significance of >31 characters.",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM12": {
              "type": "object",
              "title": "SWIM12-a2l: Are all parameters/variables implemented correctly and in the right location with the correct data type (esp. for calibration)?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM11": {
              "type": "object",
              "title": "SWIM11-Global Data/Variables: Are globals avoided or their use clearly documented as per detailed design? Is data used appropriately and change local to avoid repetitive definitions?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM9": {
              "type": "object",
              "title": "SWIM9-Complexity: Is cyclomatic complexity/LOC below the specified limit? (e.g., Polyspace metric limit <= 20).",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM14": {
              "type": "object",
              "title": "SWIM14-Type conversion: For explicit casts, has value range been checked (no under/overflow, no re-interpretation issues)? Examples: cast from signed -> unsigned; long -> short; etc.",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM8": {
              "type": "object",
              "title": "SWIM8-Style guide & clarity: Implemented artifact sufficiently clear and understandable for intended readers? Proper commenting, no unnecessary complexity; implementation structure referenced in PDP.",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM13": {
              "type": "object",
              "title": "SWIM13-Correctness: (Source) code free of obviously wrong/obsolete statements?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM8",
            "SWIM9",
            "SWIM10",
            "SWIM11",
            "SWIM12",
            "SWIM13",
            "SWIM14",
            "SWIM15"
          ]
        },
        "Completeness_2": {
          "type": "object",
          "title": "Completeness",
          "properties": {
            "SWIM16": {
              "type": "object",
              "title": "SWIM16-Complete: Are all design elements implemented? Any unused interfaces removed?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM18": {
              "type": "object",
              "title": "SWIM18-Completeness vs limits: Does the code follow defined limits? Are deviations justified in the Code metrics report?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM17": {
              "type": "object",
              "title": "SWIM17-Notation & documentation: Are code and associated documents (compiler warnings, Polyspace) properly commented and documented per guideline and naming conventions?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM16",
            "SWIM17",
            "SWIM18"
          ]
        },
        "Robustness": {
          "type": "object",
          "title": "Robustness",
          "properties": {
            "SWIM19": {
              "type": "object",
              "title": "SWIM19-Static analysis: Have MISRA C / Polyspace / Code Metrics / Compiler Warnings been judged? Are all errors solved or commented with justification (e.g., division by zero handled)?",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            },
            "SWIM20": {
              "type": "object",
              "title": "SWIM20-Design principles: Are implementations not bypassing AUTOSAR concepts? (e.g., no constant variable exchange between SW components that violates architecture guidance).",
              "properties": {
                "Ready": {
                  "type": "string",
                  "enum": [
                    "Yes",
                    "No",
                    "NA"
                  ],
                  "title": "Ready for Review"
                },
                "Comment": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "SWIM19",
            "SWIM20"
          ]
        }
      }
    }
  },
  "required": [
    "CheckList",
    "Findings",
    "Overview"
  ]
}
